{
  "name": "mihai-ltd",
  "compatibility_date": "2024-04-03",
  "main": "./.output/server/index.mjs",
  "site": {
    "bucket": "./.output/public",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
